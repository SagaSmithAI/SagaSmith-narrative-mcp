      {"id": "scene.12_heirs_choice", "session_equivalent": 1, "title": "继承人的选择", "location_ref": "location.stage", "participants": ["actor.nara", "actor.luorui", "actor.shenlu"], "purpose": "洛芮放弃逼供并把披露权交给阿砚。", "settlement_targets": ["arc.luorui", "secret.luorui.confession", "relationship.luorui_shenlu"], "exit": {"event_type": "echo-manor.luorui_commits"}, "source": {"type": "self-authored", "license": "Apache-2.0"}},
      {"id": "scene.13_directors_pause", "session_equivalent": 1, "title": "导演的停顿", "location_ref": "location.stage", "participants": ["actor.nara", "actor.shenlu", "actor.ayan"], "purpose": "申鹭在阿砚同意后才确认幸存儿童身份。", "settlement_targets": ["arc.shenlu", "secret.shenlu.child", "relationship.luorui_shenlu"], "exit": {"event_type": "echo-manor.shenlu_commits"}, "source": {"type": "self-authored", "license": "Apache-2.0"}},
