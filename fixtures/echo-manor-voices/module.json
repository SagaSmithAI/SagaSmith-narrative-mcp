      {"id": "scene.15_open_east_door", "session_equivalent": 1, "title": "打开东门", "location_ref": "location.stage", "participants": ["actor.nara", "actor.tao", "actor.ayan", "actor.jiheng", "actor.luorui", "actor.shenlu", "actor.baitang"], "purpose": "阿砚完成证词并由众人共同决定公馆未来。", "settlement_targets": ["arc.ayan", "secret.ayan.witness", "clock.truth", "location.echo_manor"], "exit": {"event_type": "echo-manor.campaign_ending"}, "source": {"type": "self-authored", "license": "Apache-2.0"}}
